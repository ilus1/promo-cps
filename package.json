{
  "name": "promo-cps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "sh -c 'set -a && . ./.env && next dev -H 127.0.0.1 -p \"$PORT\"'",
    "build": "next build",
    "start": "sh -c 'set -a && . ./.env && next start -H 127.0.0.1 -p \"$PORT\"'",
    "lint": "eslint .",
    "test": "vitest run",
    "ml:capture": "tsx --env-file=.env scripts/ml-capture.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "sh -c 'set -a && . ./.env && drizzle-kit migrate'"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.9",
    "playwright": "^1.61.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
